# Copy to backend/.env and fill in. Never commit the real .env.
JWT_SECRET=change-this-to-a-long-random-string-of-32-plus-chars

# Default: local SQLite file. For MySQL (as in our proposal):
# DATABASE_URL=mysql+pymysql://ciq_user:your_password@localhost:3306/continuityiq
DATABASE_URL=

# GenAI engine: none | ollama | groq | gemini | openai | anthropic
# 'none' = offline rules engine (always works, no internet).
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
